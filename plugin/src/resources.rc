// The dyeable item table is built into the plugin so it works as a single file.
// A DyeAll.dyeables.tsv next to the plugin overrides it (see Paths::ReadDataText).
#include <windows.h>
#include "version.h"

DYEABLES RCDATA "../data/dyeables.tsv"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DYEALL_VERSION_MAJOR,DYEALL_VERSION_MINOR,DYEALL_VERSION_PATCH,0
 PRODUCTVERSION DYEALL_VERSION_MAJOR,DYEALL_VERSION_MINOR,DYEALL_VERSION_PATCH,0
 FILEOS 0x40004L
 FILETYPE 0x2L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Dye All for Crimson Desert"
            VALUE "FileVersion", DYEALL_VERSION
            VALUE "ProductName", "Dye All"
            VALUE "ProductVersion", DYEALL_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
